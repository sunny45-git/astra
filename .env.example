# ASTRA Environment Configuration Template
# Copy this file to .env and configure your local/production values:
# cp .env.example .env

# Server Configuration
PORT=5000
HOST=0.0.0.0

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Initial Administrator Seed Credentials
ADMIN_EMAIL=admin@astra.dev
ADMIN_PASSWORD=your_secure_admin_password_here

# Optional: MongoDB URI (Leave commented to use the built-in local JSON database engine)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/astra_portfolio?retryWrites=true&w=majority
