# ==========================================
# ASTRA Production & Repository Ignore Rules
# ==========================================

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build Outputs
dist/
dist-ssr/
build/
coverage/

# Environment Variables & Private Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Local Runtime Data & File Uploads
server/data/*.json
!server/data/.gitkeep
!server/data/*.example.json
server/uploads/*
!server/uploads/.gitkeep

# Temporary & Log Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.temp/
.tmp/
scratch/

# IDE & OS Metadata
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini
*.lnk
*.url

